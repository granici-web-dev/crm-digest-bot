# Скопировать в .env и заполнить. .env в репозиторий не попадает.
# Таймзона не настраивается: Europe/Bucharest задаётся в коде явно (STACK.md).

# --- mefi CRM ---
# Базовый URL API, с префиксом /api/v1, как в docs/mefi-api-reference/README.md
MEFI_BASE_URL=https://bellesofa.meficrm.com/api/v1
# API-ключ со скоупом leads:read
MEFI_API_KEY=

# --- Telegram ---
# Токен основного бота: отчёты в группу и ответы на вопросы
TELEGRAM_BOT_TOKEN=
# Токен служебного бота: ошибки, алерты UNMAPPED, сбои источников
TELEGRAM_OPS_BOT_TOKEN=
# chat_id продовой управленческой группы
TELEGRAM_GROUP_CHAT_ID=
# chat_id тестовой группы для прогонов с DRY_RUN=1
TELEGRAM_TEST_CHAT_ID=
# chat_id чата служебного бота
TELEGRAM_OPS_CHAT_ID=
# Telegram user_id администраторов (/settings), через запятую
TELEGRAM_ADMIN_IDS=

# --- LLM ---
# Ключ Anthropic для режима вопросов в чате
ANTHROPIC_API_KEY=

# --- Postgres ---
# Строка подключения SQLAlchemy. В проде оставить пустой: docker-compose.prod.yml
# собирает её из POSTGRES_* с хостом postgres.
DATABASE_URL=
# Пользователь, пароль и база для docker-compose.yml и docker-compose.prod.yml. В проде пароль
# только hex (openssl rand -hex 24): он вставляется в URL подключения без экранирования.
# Порт публикует только локальный docker-compose.yml, на 127.0.0.1.
# DATABASE_URL тогда postgresql+asyncpg://digest:<пароль>@localhost:5432/digest
POSTGRES_USER=digest
POSTGRES_PASSWORD=
POSTGRES_DB=digest
POSTGRES_PORT=5432

# --- Тенант ---
# id строки в таблице tenants; tenant_id пишется в каждую таблицу
TENANT_ID=sofabelle

# --- Режим работы ---
# 1 = отправлять только в тестовую группу, в продовую ничего не уходит
DRY_RUN=
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=

# --- Docker Compose ---
# Только на сервере: раскомментировать, тогда docker compose без -f работает с продовым стеком
# (docs/deploy.md). Локально не задавать, иначе docker compose возьмёт продовый файл.
# COMPOSE_FILE=docker-compose.prod.yml

# --- Этап 2: источник B (Oferte/Contracte через Playwright) ---
# Логин сервисного read-only пользователя mefi без 2FA
MEFI_SERVICE_LOGIN=
# Пароль сервисного пользователя mefi
MEFI_SERVICE_PASSWORD=
