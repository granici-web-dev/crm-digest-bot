{% set level_names = {"scr_elite": "Elită", "scr_bine": "Bine", "scr_minim": "Minim", "below_levels": "Sub minim"} %}
{% macro row(label, scr_row) %}{{ label }} {{ scr_row.scr | percent1 }}{% if scr_row.level %} · {{ level_names[scr_row.level] }}{% endif %}{% if scr_row.meets_target is true %} ✓{% elif scr_row.meets_target is false %} ✗{% endif %}{% endmacro %}
<b>Conversie (SCR) pe showroom</b>, țintă {{ scr_target }}
<i>{% for name, value in levels %}{{ level_names[name] }} ≥{{ value | percent1 }}{% if not loop.last %} · {% endif %}{% endfor %}</i>
{% for showroom in showrooms %}
{{ row(showroom or without_showroom, scr.by_showroom[showroom]) }}
{% endfor %}
<b>{{ row("Total", scr.company) }}</b>
